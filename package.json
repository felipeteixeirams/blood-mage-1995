{
  "name": "@workspace/bloodmage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:game": "tsc -p artifacts/bloodmage/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "verify": "node scripts/verify-assets.cjs && npm run typecheck && npm run build",
    "verify:all": "npm run typecheck && npm run typecheck:game && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "vitest related"
  },
