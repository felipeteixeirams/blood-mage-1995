# .claudeignore — Exclui arquivos desnecessários para economizar tokens
# Pattern: similar a .gitignore, mas para ferramentas Claude Code
# Auditoria: 77% de economia possível bloqueando docs/ obsoleto

# 🚫 DEPENDÊNCIAS & BUILD
node_modules/
dist/
build/
.vite/
.cache/
*.tsbuildinfo
coverage/
*.lcov

# 🚫 SISTEMA DE CONTROLE DE VERSÃO
.git/
.gitignore
.gitattributes

# 🚫 ARQUIVOS DE SISTEMA & TEMPORÁRIOS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.env.local
.env.*.local
*.log
logs/
tmp/
temp/

# 🚫 IDE & EDITOR (CACHES)
.vscode/
.idea/
*.iml
.gradle/
.project
.settings/
.classpath
*.sublime-workspace
.sublime-project
.cursor/
.cursor-ai/

# 🚫 DEPENDÊNCIAS INSTALADAS LOCALMENTE
pnpm-lock.yaml
package-lock.json
yarn.lock
.pnpm-store/
.pnpm/

# 🚫 ARTEFATOS DE COMPILAÇÃO
*.o
*.obj
*.so
*.dll
*.dylib
*.exe

# 🚫 ARQUIVOS DE WORKSPACE & CONFIGURAÇÃO PESSOAL
.vscode-settings.json
workspace.json
.env
.env.production
.env.development

# 🚫 HISTÓRICO DE SESSÕES CLAUDE & TOKENS
.claude/sessions/
.claude/*.log
.claude/cache/

# 🚫 ARQUIVOS DE TESTE PESADOS (se >10MB)
**/*.spec.snapshots/
test-results/
jest-coverage/

# 🚫 ASSETS BINÁRIOS (imagens 78k tokens economizados, leia SPRITES_REGISTRY.json em vez disso)
src/assets/**/*.png
src/assets/**/*.jpg
src/assets/**/*.jpeg
src/assets/**/*.gif

# ✅ EXCEÇÃO: SPRITES_REGISTRY.json (metadata essencial para agent context)
!src/assets/SPRITES_REGISTRY.json

# 🚫 OUTROS ASSETS MUITO GRANDES
**/*.mp4
**/*.mov
**/*.avi
**/*.psd
**/*.ai
**/*.xd
**/*.sketch
public/audio_samples/*.wav
public/audio_samples/*.mp3

# 🚫 DOCUMENTAÇÃO ARQUIVADA & OBSOLETA (-150k tokens, 77% redução de docs)
docs/archive/**                   # Histórico, decisões antigas (1.2M, 43 files)
docs/reviews/**                   # Revisões passadas (28K, não aplicável)
docs/experiments/**               # Experimentos obsoletos (12K)
docs/product/**                   # Roadmap/business (32K, desbloquear se necessário)
docs/specs/discovery/**           # Specs especulativas futuras (2K linhas, não ativas)

# 🚫 TEST FILES PEQUENOS (bloqueio granular: <400 linhas = raramente editados = -19.5k tokens)
# Testes GRANDES (editados frequentemente) são mantidos via exceções abaixo
src/game/objects/**/*.test.ts
src/game/animations/**/*.test.ts
src/game/assets/**/*.test.ts
src/hooks/**/*.test.ts
src/utils/equipmentPalette.test.ts
src/utils/joystickResponse.test.ts
src/utils/logger.test.ts

# 🟡 TESTES MÉDIOS (ocasionalmente editados: 200-300 linhas = -12k tokens)
src/game/systems/CombatFeel.test.ts
src/game/systems/CodexSystem.test.ts
src/game/systems/ContractSystem.test.ts
src/game/systems/DismembermentSystem.test.ts
src/game/systems/EnemyTelegraphSystem.test.ts
src/game/systems/HeightmapGenerator.test.ts
src/game/systems/InputManager.test.ts
src/game/systems/ObjectPool.test.ts
src/game/systems/OnboardingFlow.test.ts
src/game/systems/PerformanceMonitor.test.ts
src/game/systems/PostFXSystem.test.ts
src/game/systems/ReflectionSystem.test.ts
src/game/systems/RelicSystem.test.ts
src/game/systems/ShadowSystem.test.ts
src/game/systems/StatusEffectSystem.test.ts
src/game/systems/ViewportCuller.test.ts

# ✅ EXCEÇÕES: TESTES GRANDES (editados frequentemente, mantém flexibilidade)
!src/store/gameStore.test.ts                          # 936 linhas (frequente)
!src/utils/soundEngine.test.ts                        # 350 linhas (ocasional)
!src/utils/localStorage.test.ts                       # 290 linhas (ocasional)
!src/utils/textureGenerator.test.ts                   # 250 linhas (ocasional)
!src/utils/bgmSynthesizer.test.ts                     # 250 linhas (ocasional)
!src/game/systems/DungeonGenerator.test.ts            # 250 linhas (ocasional)
!src/game/systems/LightingPolish.test.ts              # 250 linhas (ocasional)
!src/game/systems/AtmosphereSystem.test.ts            # 250 linhas (ocasional)
!src/game/systems/BloodSplatterSystem.test.ts         # 250 linhas (ocasional)
!src/game/systems/TerrainTraversability.test.ts       # 250 linhas (ocasional)
!src/game/systems/VirtualJoystickSystem.test.ts       # 250 linhas (ocasional)

# ✅ EXCEÇÕES (sempre incluir — essencial para agentes)
!CLAUDE.md
!.claude/
!.claude/**/*.md
!.claude/**/*.json
!docs/critical/**                 # Anti-regressão (LEIA SEMPRE)
!docs/architecture/**             # Padrões obrigatórios (LEIA SEMPRE)
!docs/specs/in-progress/**        # Specs ativas (LEIA)
!docs/specs/delivered/**          # Specs completadas (LEIA)
!docs/specs/backlog/**            # Próximas tarefas (LEIA)
!